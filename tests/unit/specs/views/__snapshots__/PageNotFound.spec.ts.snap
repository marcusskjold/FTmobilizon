exports[`PageNotFound > Show simple 1`] = `
"<section class="container mx-auto py-4 is-max-desktop max-w-2xl">
  <div class="">
    <div class="">
      <h1 class="text-4xl mb-3">The page you're looking for doesn't exist.</h1>
      <p>Please make sure the address is correct and that the page hasn't been moved.</p>
      <p>Please contact this instance's Mobilizon admin if you think this is a mistake.</p><!--  The following should just be replaced with the SearchField component but it fails for some reason  -->
      <form class="flex flex-wrap mt-3">
        <div data-oruga="field" class="o-field" expanded="">
          <!---->
          <div data-oruga="input" class="o-input o-input--expanded"><span data-oruga="icon" class="o-icon o-input__icon-left"><i class="mdi mdi-magnify mdi-24px"></i></span><input aria-labelledby="v-0" id="v-2" type="search" data-oruga-input="search" class="o-input__input o-input__input--iconspace-left o-input__input--placeholder" autocomplete="off" placeholder="Search events, groups, etc.">
            <!---->
            <!---->
          </div>
          <p class="control"><button type="submit" class="button is-primary">Search</button></p>
          <!---->
        </div>
      </form>
    </div>
  </div>
</section>"
`;
